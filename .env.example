# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# E-mail (https://resend.com)
# Lokálně se posílá přes API route /api/send-email (klíč RESEND_API_KEY na serveru).
RESEND_API_KEY=re_your_key
# Pro testování na free plánu použijte: Rezervace <onboarding@resend.dev>
# POZOR: onboarding@resend.dev doručuje e-maily POUZE na e-mail registrovaný
# ve vašem Resend účtu (na jiné adresy se e-maily NEodesílají a končí chybou).
# Po verifikaci vlastní domény v Resend změňte na: Rezervace <rezervace@vasedomena.cz>
RESEND_FROM=Rezervace <rezervace@vasedomena.cz>

# PRODUKCE (GitHub Pages = statický hosting): API route /api/send-email nefunguje.
# Nasaďte Supabase Edge Function (supabase/functions/send-email) a nastavte její URL:
#   https://VAS_PROJECT_REF.supabase.co/functions/v1/send-email
# (Edge Function používá stejné secrets RESEND_API_KEY a RESEND_FROM v Supabase.)
NEXT_PUBLIC_SEND_EMAIL_URL=

# Platby - bankovní údaje pro QR kód
NEXT_PUBLIC_BANK_ACCOUNT=123456789/0100
NEXT_PUBLIC_BANK_IBAN=CZ0000000000000000000000
NEXT_PUBLIC_BANK_SWIFT=KOMBCZPP
# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# E-mail (https://resend.com)
# Lokálně se posílá přes API route /api/send-email (klíč RESEND_API_KEY na serveru).
RESEND_API_KEY=re_your_key
# Pro testování na free plánu použijte: Rezervace <onboarding@resend.dev>
# POZOR: onboarding@resend.dev doručuje e-maily POUZE na e-mail registrovaný
# ve vašem Resend účtu (na jiné adresy se e-maily NEodesílají a končí chybou).
# Po verifikaci vlastní domény v Resend změňte na: Rezervace <rezervace@vasedomena.cz>
RESEND_FROM=Rezervace <rezervace@vasedomena.cz>

# Globální přepínač e-mailového providera: resend (default) | smtp (Nodemailer).
# - resend: posílá přes Resend API (RESEND_API_KEY, RESEND_FROM).
# - smtp: posílá přes SMTP (Nodemailer) – např. Gmail (smtp.gmail.com) nebo SMTP
#   domény (ONE.CZ). Funguje v API route (local/Vercel) a v Edge Function
#   (GH Pages/Vercel) – obě čtou stejnou proměnnou.
EMAIL_PROVIDER=resend

# SMTP (Nodemailer) – použije se, když EMAIL_PROVIDER=smtp.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=<vaš gmail>, SMTP_PASS=<app password – NE hlavní heslo!>
#        (app password: Google účet → Bezpečnost → Dvoufázové ověření → App passwords)
# ONE.CZ (po verifikaci domény): SMTP_HOST=<smtp one.cz>, SMTP_USER=pujcovna@bikegallery.cz
# SMTP_SECURE: prázdné = auto (port 465 → SSL, port 587 → STARTTLS); "true" vynutí SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Volitelná from adresa (default: SMTP_USER).
SMTP_FROM=

# PRODUKCE (GitHub Pages = statický hosting): API route /api/send-email nefunguje.
# Nasaďte Supabase Edge Function (supabase/functions/send-email) a nastavte její URL:
#   https://VAS_PROJECT_REF.supabase.co/functions/v1/send-email
# (Edge Function používá stejné secrets RESEND_API_KEY a RESEND_FROM v Supabase.)
# DŮLEŽITÉ: NEXT_PUBLIC_* proměnné se zapékají do buildu → tuto hodnotu musíte
# nastavit i jako GitHub Actions secret (Settings → Secrets and variables → Actions)
# se stejným názvem NEXT_PUBLIC_SEND_EMAIL_URL, jinak deploy na GitHub Pages
# e-maily nepošle (API route na statickém hostingu neexistuje, vrací HTTP 405).
NEXT_PUBLIC_SEND_EMAIL_URL=

# Tajný klíč pro odesílání e-mailů (ochrana veřejné e-mailové funkce před zneužitím).
# - Lokálně: SEND_EMAIL_SECRET (server) a NEXT_PUBLIC_SEND_EMAIL_SECRET (client) – stejná hodnota.
# - Edge Function: supabase secrets set SEND_EMAIL_SECRET=...
# - GitHub Actions secret NEXT_PUBLIC_SEND_EMAIL_SECRET (stejná hodnota) pro build.
# Hodnota: libovolný dlouhý náhodný řetězec (např. `openssl rand -hex 32`).
NEXT_PUBLIC_SEND_EMAIL_SECRET=
SEND_EMAIL_SECRET=

# Platby - bankovní údaje pro QR kód
NEXT_PUBLIC_BANK_ACCOUNT=123456789/0100
NEXT_PUBLIC_BANK_IBAN=CZ0000000000000000000000
NEXT_PUBLIC_BANK_SWIFT=KOMBCZPP